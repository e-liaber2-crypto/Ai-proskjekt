# Valfritt. Standard er data/ i prosjektmappa. Ikkje legg videofiler i Git.
# DATA_DIR=C:/Users/namn/Ai-proskjekt/data

# Valfritt dersom ffmpeg og ffprobe ikkje finst på PATH.
# FFMPEG_BIN=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_BIN=C:/ffmpeg/bin/ffprobe.exe

# Valfri AI-redigering. Set GEMINI_API_KEY i det lokale servermiljøet eller .env.
# Ikkje legg ein ekte nøkkel i denne dømefila, frontend eller Git.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Enkel redigering treng ingen API-nøkkel. Teksting, betaling og sosiale API-ar
# er framleis ikkje integrerte.
